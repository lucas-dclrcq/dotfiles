# Custom rules for windows

# firefox
for_window [title="Firefox Developer Edition — Sharing Indicator"] floating enable

#thunderbird
for_window [title="^.* Reminders" app_id="thunderbird"] floating enable

# libreoffice
for_window [class="Soffice"] resize set 1000 750
for_window [class="Soffice"] move absolute position center
assign [class="Soffice"] → $ws8

# feh
for_window [class="feh"] floating enable
for_window [class="feh"] move absolute position center

# feh
for_window [class="updates_alacritty"] floating enable
for_window [class="updates_alacritty"] move absolute position center

# evince
for_window [class="evince"] floating enable
for_window [class="evince"] move absolute position center

# Start more windows floating.
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# IntelliJ
assign [class="jetbrains-idea" title="(.*)IntelliJ IDEA"] → $ws4
for_window [class="jetbrain-idea"] floating enable
assign [class="sun-awt-X11-XFramePeer" class="jetbrains-idea"] → $ws4
assign [class="sun-awt-X11-XWindowPeer" class="java-lang-Thread"] → $ws4
for_window [class="sun-awt-X11-XWindowPeer" class="java-lang-Thread"] floating enable
for_window [class="jetbrains-idea" title="(.*)Default Changelist"] fullscreen enable
for_window [title="Welcome to IntelliJ IDEA"] floating enable

# window border
for_window [class="^.*"] border pixel 0

# prevent idling when a window is fullscreen
for_window [class="^.*"] inhibit_idle fullscreen
for_window [app_id="^.*"] inhibit_idle fullscreen

floating_maximum_size 1280 x 720
floating_minimum_size -1 x -1

default_border none

gaps inner 10
gaps outer 0

for_window [urgent="latest"] focus